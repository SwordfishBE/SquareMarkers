  "authors": [
    "SwordfishBE",
    "Gjorgdy (original Pl3xMarkers)"
  ],
  "contact": {
	"homepage": "https://github.com/SwordfishBE/SquareMarkers",
    "sources": "https://github.com/SwordfishBE/SquareMarkers",
    "issues": "https://github.com/SwordfishBE/SquareMarkers/issues",
    "email": "swordfishbe@locutus.net"
  },
  "license": "Apache-2.0",
  "icon": "assets/squaremarkers/icon.png",
